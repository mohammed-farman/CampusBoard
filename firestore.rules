rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function usernamePath(username) {
      return /databases/$(database)/documents/usernames/$(username);
    }

    function validUsername(username) {
      return username is string && username.matches('^[a-z0-9_]{3,24}$');
    }

    function validProfile(data) {
      return data.keys().hasOnly([
          'username',
          'displayName',
          'bio',
          'interests',
          'photoPath',
          'photoContentType',
          'bannerPath',
          'bannerContentType',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasAll(['username', 'displayName', 'createdAt', 'updatedAt'])
        && validUsername(data.username)
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 50
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 500))
        && (!('interests' in data) || (data.interests is string && data.interests.size() <= 200))
        && (!('photoPath' in data) || (
          data.photoPath is string
          && data.photoPath.matches('^users/' + request.auth.uid + '/profile/avatar$')
        ))
        && (!('photoContentType' in data) || data.photoContentType in [
          'image/jpeg',
          'image/png',
          'image/webp'
        ])
        && (!('bannerPath' in data) || (
          data.bannerPath is string
          && data.bannerPath.matches('^users/' + request.auth.uid + '/profile/banner$')
        ))
        && (!('bannerContentType' in data) || data.bannerContentType in [
          'image/jpeg',
          'image/png',
          'image/webp'
        ])
        && (('photoPath' in data) == ('photoContentType' in data))
        && (('bannerPath' in data) == ('bannerContentType' in data));
    }

    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == uid
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && existsAfter(usernamePath(request.resource.data.username))
        && getAfter(usernamePath(request.resource.data.username)).data.uid == uid;
      allow update: if signedIn()
        && request.auth.uid == uid
        && validProfile(request.resource.data)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.username == resource.data.username
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'bio',
          'interests',
          'photoPath',
          'photoContentType',
          'bannerPath',
          'bannerContentType',
          'updatedAt'
        ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'photoPath',
            'photoContentType'
          ])
          || (
            ('photoPath' in request.resource.data) == ('photoContentType' in request.resource.data)
          )
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'bannerPath',
            'bannerContentType'
          ])
          || (
            ('bannerPath' in request.resource.data) == ('bannerContentType' in request.resource.data)
          )
        );
      allow delete: if false;
    }

    match /usernames/{username} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && validUsername(username)
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && existsAfter(profilePath(request.auth.uid))
        && getAfter(profilePath(request.auth.uid)).data.username == username;
      allow update, delete: if false;
    }

    function isConversationMember(conversationId) {
      let conversationPath = /databases/$(database)/documents/conversations/$(conversationId);
      return signedIn()
        && exists(conversationPath)
        && (!('blocked' in get(conversationPath).data) || get(conversationPath).data.blocked != true)
        && request.auth.uid in get(conversationPath).data.participantUids;
    }

    match /conversations/{conversationId} {
      allow get, list: if isConversationMember(conversationId);
      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow get, list: if isConversationMember(conversationId);
        allow create, update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
